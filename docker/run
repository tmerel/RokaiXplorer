#!/usr/bin/env bash
set -euo pipefail

readonly curr_dir="$(realpath "$(dirname "$0")")"

tag=""
force=""
daemon=""

usage() {
    cat <<EOF
Usage: $0 --tag NAME [--force] [--daemon]

Options:
  --tag NAME    Tag name under which the docker will be saved (username/NAME).
  --force       Force rebuild of the docker image, even if it exists.
  --daemon      Run docker container in background (detached).
EOF
    exit 1
}

# --- Parse args ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --tag)
            shift
            tag="${1:-}"
            ;;
        --force)
            force=1
            ;;
        --daemon)
            daemon=1
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
    shift
done

# --- Validation ---
if [[ -z "$tag" ]]; then
    echo "❌ Missing required option: --tag"
    usage
fi

# --- Functions ---
setup() {
    echo "🔨 Building docker image $(id -un)/${tag} ..."
    docker build "${curr_dir}" -t "$(id -un)/${tag}" \
        --build-arg "USER_NAME=$(id -un)" \
        --build-arg "GROUP_NAME=$(id -gn)" \
        --build-arg "GROUP_ID=$(id -g)" \
        --build-arg "USER_ID=$(id -u)"
}

run() {
    echo "🚀 Running container from image $(id -un)/${tag} ..."
    docker run \
        --mount "type=bind,source=$(realpath "${PWD}/.."),destination=$(realpath "${PWD}/.."),readonly=false" \
        --mount "type=bind,source=${HOME}/.ssh,destination=${HOME}/.ssh,readonly=true" \
        -w "${PWD}/../.." \
        --net host \
        --userns host \
        --rm \
        ${daemon:+-d} \
        "$(id -un)/${tag}" \
        /bin/bash
}

# --- Main ---
if [[ -z "$(docker images -q "$(id -un)/${tag}" 2>/dev/null)" ]] || [[ -n "$force" ]]; then
    setup
fi

run
